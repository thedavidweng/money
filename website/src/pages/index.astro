---
import '../styles/global.css';

const base = import.meta.env.BASE_URL;
const repo = 'https://github.com/thedavidweng/money';
const docs = (path: string) => `${repo}/blob/main/${path}`;

const features = [
	{
		title: 'Encrypted SQLite',
		desc: 'Financial data at rest in an encrypted local file you control — not plaintext SQLite, not someone else’s cloud.',
		icon: 'lock',
	},
	{
		title: 'BYOK providers',
		desc: 'Plaid, Bridge, and more as adapters. You bring credentials; no managed proxy or subscription to <code>money</code>.',
		icon: 'plug',
	},
	{
		title: 'Stable JSON contracts',
		desc: 'Versioned envelopes, deterministic sorting and pagination — built for scripts, cron, and agents.',
		icon: 'braces',
	},
	{
		title: 'CLI-first',
		desc: 'Human output by default; <code>--json</code> when you need parseable stdout. No web server required.',
		icon: 'terminal',
	},
	{
		title: 'Explicit sync boundary',
		desc: 'Read commands use local data only. Network I/O happens when you link or sync — not on every query.',
		icon: 'shield',
	},
	{
		title: 'Demo mode',
		desc: '<code>money demo …</code> runs against bundled non-persistent sample data — no credentials required.',
		icon: 'play',
	},
];

const promoVideoId = 'vjHybT9BPU4';
const promoEmbedUrl = `https://www.youtube.com/embed/${promoVideoId}?rel=0`;

const docsList = [
	{ name: 'docs/PRD.md', title: 'Product requirements', desc: 'Why money exists, what it commits to, and what it is not.', path: 'docs/PRD.md' },
	{ name: 'docs/ARCHITECTURE.md', title: 'Architecture', desc: 'Module boundaries, data flow, and contract design.', path: 'docs/ARCHITECTURE.md' },
	{ name: 'docs/SCHEMA.md', title: 'Database schema', desc: 'Canonical tables for institutions, items, accounts, transactions.', path: 'docs/SCHEMA.md' },
	{ name: 'docs/CONFIG.md', title: 'Configuration', desc: 'Config loading, env files, secrets, and resolution rules.', path: 'docs/CONFIG.md' },
	{ name: 'docs/ROADMAP.md', title: 'Roadmap', desc: 'Phased development, current focus, and deferred work.', path: 'docs/ROADMAP.md' },
	{ name: 'CONTRIBUTING.md', title: 'Contributing', desc: 'Project rules, donor policy, and contribution discipline.', path: 'CONTRIBUTING.md' },
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content="money — local-first personal finance backend with encrypted SQLite, a CLI, and stable JSON contracts for AI agents. No embedded AI, no required server." />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#0a0c0b" />
		<link rel="icon" type="image/png" href={`${base}favicon.png`} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
		<title>money — local-first finance backend for AI agents</title>
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>

		<header class="site-header">
			<div class="layout-shell header-shell">
				<a class="brand" href={base}>
					<img src={`${base}Golden-Toad-logo.webp`} alt="" width="32" height="32" />
					<span>money</span>
				</a>
				<nav class="nav" aria-label="Page">
					<a href="#intro-video">Watch</a>
					<a href="#problem">Why</a>
					<a href="#features">Features</a>
					<a href="#quick-start">Quick start</a>
					<a href="#architecture">Architecture</a>
					<a href="#docs">Docs</a>
					<span class="nav-divider" aria-hidden="true"></span>
					<a href={repo}>
						GitHub
					</a>
				</nav>
			</div>
		</header>

		<main id="main" class="layout-shell layout-main">
			<!-- ============================ Hero ============================ -->
			<section class="hero" aria-labelledby="hero-heading">
				<div class="hero-text">
					<p class="hero-eyebrow">
						<span>CLI</span>
						<span class="dot" aria-hidden="true"></span>
						<span>Local-first</span>
						<span class="dot" aria-hidden="true"></span>
						<span>For AI agents</span>
						<span class="dot" aria-hidden="true"></span>
						<span class="tag-version">v0.x · pre-release</span>
					</p>
					<h1 id="hero-heading">Local-first finance data your&nbsp;agent can rely on.</h1>
					<p class="lede">
						Pull accounts and transactions from providers you configure, store them in <span class="tech-pill">encrypted&nbsp;SQLite</span>, and
						automate with stable <span class="tech-pill">CLI&nbsp;+&nbsp;JSON&nbsp;contracts</span>. No embedded AI, no hosted ledger, no
						long-running server required.
					</p>
					<div class="cta-row">
						<a class="btn btn-primary" href={`${repo}#quick-start`}>
							Get started
							<svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3.5 8h9M9 4.5l3.5 3.5L9 11.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
						</a>
						<a class="btn btn-secondary" href={repo}>
							<svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8a8 8 0 0 0 5.47 7.59c.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
							Source
						</a>
					</div>
					<div class="cta-meta">
						<span><span class="check">✓</span> MIT licensed</span>
						<span><span class="check">✓</span> Single Go binary</span>
						<span><span class="check">✓</span> No telemetry</span>
						<a class="meta-link" href={`${repo}/releases`}>Releases →</a>
					</div>
				</div>

				<aside class="hero-terminal" aria-label="Example money commands">
					<div class="term-titlebar">
						<div class="term-dots" aria-hidden="true">
							<span class="red"></span>
							<span class="yellow"></span>
							<span class="green"></span>
						</div>
						<span class="term-title">~/projects/finance — money</span>
					</div>
					<div class="term-body">
						<span class="term-line"><span class="term-comment"># no credentials needed</span></span>
						<span class="term-line"><span class="term-prompt">$</span> <span class="term-cmd">money</span> demo accounts list <span class="term-flag">--json</span></span>
						<span class="term-line"><span class="term-output">{`{`}</span></span>
						<span class="term-line"><span class="term-output">  </span><span class="term-key">"meta"</span><span class="term-output">: {`{`}</span></span>
						<span class="term-line"><span class="term-output">    </span><span class="term-key">"schema"</span><span class="term-output">: </span><span class="term-str">"1.0.0"</span><span class="term-output">,</span></span>
						<span class="term-line"><span class="term-output">    </span><span class="term-key">"demo"</span><span class="term-output">: </span><span class="term-num">true</span></span>
						<span class="term-line"><span class="term-output">  {`}`},</span></span>
						<span class="term-line"><span class="term-output">  </span><span class="term-key">"data"</span><span class="term-output">: {`{ `}</span><span class="term-key">"accounts"</span><span class="term-output">: [</span></span>
						<span class="term-line"><span class="term-output">    {`{ `}</span><span class="term-key">"id"</span><span class="term-output">: </span><span class="term-str">"acc_2Hf…"</span><span class="term-output">,</span></span>
						<span class="term-line"><span class="term-output">      </span><span class="term-key">"name"</span><span class="term-output">: </span><span class="term-str">"Chase Checking"</span><span class="term-output"> {`}`},</span></span>
						<span class="term-line"><span class="term-output">    {`{ `}</span><span class="term-key">"id"</span><span class="term-output">: </span><span class="term-str">"acc_9Kp…"</span><span class="term-output">,</span></span>
						<span class="term-line"><span class="term-output">      </span><span class="term-key">"name"</span><span class="term-output">: </span><span class="term-str">"Amex Gold"</span><span class="term-output"> {`}`}</span></span>
						<span class="term-line"><span class="term-output">  ] {`}`},</span></span>
						<span class="term-line"><span class="term-output">  </span><span class="term-key">"errors"</span><span class="term-output">: []</span></span>
						<span class="term-line"><span class="term-output">{`}`}</span></span>
						<span class="term-blank" aria-hidden="true"></span>
						<span class="term-line"><span class="term-prompt">$</span> <span class="term-cmd">money</span> tx search <span class="term-str">"Costco"</span><span class="term-cursor" aria-hidden="true"></span></span>
					</div>
				</aside>
			</section>

			<!-- ============================ Promo video ============================ -->
			<section id="intro-video" class="intro-video" aria-labelledby="intro-video-heading">
				<p class="section-eyebrow">Introduction</p>
				<h2 id="intro-video-heading">See money in action</h2>
				<p class="section-lede intro-video-lede">
					A product introduction: what money does, how the CLI fits in, and how JSON contracts work for external agents.
				</p>
				<div class="video-shell">
					<div class="video-frame">
						<iframe
							src={promoEmbedUrl}
							title="money — product introduction"
							loading="lazy"
							allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
							referrerpolicy="strict-origin-when-cross-origin"
							allowfullscreen
						></iframe>
					</div>
				</div>
				<p class="video-caption">
					Hosted on YouTube · <a href={`https://youtu.be/${promoVideoId}`}>Open in new tab</a>
				</p>
			</section>

			<!-- ============================ Why ============================ -->
			<section id="problem" aria-labelledby="problem-heading">
				<p class="section-eyebrow">Why money</p>
				<h2 id="problem-heading">Boring infrastructure for finance, not another advisor</h2>
				<div class="problem-grid">
					<div class="problem-text">
						<p>
							Many personal finance workflows depend on a single SaaS for truth, on products that bundle AI advisors, or on a full web app you must
							keep online. That conflicts with owning your data, choosing providers, and giving an <em>external</em> agent predictable,
							deterministic primitives.
						</p>
						<p>
							<span class="inline-code">money</span> takes the opposite shape: a user-owned encrypted database, explicit sync to BYOK providers,
							and machine-readable envelopes. <strong>Your agent owns reasoning and memory — not the tool.</strong>
						</p>
					</div>
					<div class="contrast-card" role="group" aria-label="Design boundaries">
						<h3>By design</h3>
						<ul class="contrast-list">
							<li><span class="icon icon-yes" aria-hidden="true">✓</span> Local CLI, machine-readable JSON</li>
							<li><span class="icon icon-yes" aria-hidden="true">✓</span> Encrypted SQLite, BYOK providers</li>
							<li><span class="icon icon-yes" aria-hidden="true">✓</span> Stable, versioned contracts</li>
							<li><span class="icon icon-no" aria-hidden="true">−</span> <span class="label">No embedded AI advisor</span></li>
							<li><span class="icon icon-no" aria-hidden="true">−</span> <span class="label">No hosted subscription</span></li>
							<li><span class="icon icon-no" aria-hidden="true">−</span> <span class="label">No required web dashboard</span></li>
						</ul>
					</div>
				</div>
			</section>

			<!-- ============================ Features ============================ -->
			<section id="features" aria-labelledby="features-heading">
				<p class="section-eyebrow">What you get</p>
				<h2 id="features-heading">A small, deep set of primitives</h2>
				<p class="section-lede">Each capability is a stable command contract. Adding a provider, an import source, or a budget primitive doesn't change how your agent talks to <span class="inline-code">money</span>.</p>
				<div class="feature-grid">
					{features.map((f) => (
						<article class="feature-card">
							<span class="feature-icon" aria-hidden="true">
								{f.icon === 'lock' && (<svg viewBox="0 0 24 24" fill="none"><path d="M6 10V8a6 6 0 1 1 12 0v2M5 10h14a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-9a1 1 0 0 1 1-1Z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>)}
								{f.icon === 'plug' && (<svg viewBox="0 0 24 24" fill="none"><path d="M9 3v5M15 3v5M7 8h10v3a5 5 0 0 1-10 0V8Zm5 8v5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>)}
								{f.icon === 'braces' && (<svg viewBox="0 0 24 24" fill="none"><path d="M9 4H7a2 2 0 0 0-2 2v4a2 2 0 0 1-2 2 2 2 0 0 1 2 2v4a2 2 0 0 0 2 2h2M15 4h2a2 2 0 0 1 2 2v4a2 2 0 0 0 2 2 2 2 0 0 0-2 2v4a2 2 0 0 1-2 2h-2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>)}
								{f.icon === 'terminal' && (<svg viewBox="0 0 24 24" fill="none"><path d="m5 8 4 4-4 4M11 16h7M3 4h18a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1Z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>)}
								{f.icon === 'shield' && (<svg viewBox="0 0 24 24" fill="none"><path d="M12 3 4 6v6c0 5 3.5 8.5 8 9 4.5-.5 8-4 8-9V6l-8-3Zm-3 9 2 2 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>)}
								{f.icon === 'play' && (<svg viewBox="0 0 24 24" fill="none"><path d="M8 5v14l11-7L8 5Z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>)}
							</span>
							<strong>{f.title}</strong>
							<span set:html={f.desc}></span>
						</article>
					))}
				</div>
			</section>

			<!-- ============================ Quick start ============================ -->
			<section id="quick-start" aria-labelledby="qs-heading">
				<p class="section-eyebrow">Quick start</p>
				<h2 id="qs-heading">Run in two paths: demo, or real provider</h2>
				<p class="section-lede">Install once. Try the demo without credentials, then configure a provider to sync your own data. Full configuration rules live in the <a href={docs('docs/CONFIG.md')}>config contract</a>.</p>
				<div class="quickstart">
					<article class="qs-card">
						<div class="qs-card-head">
							<p class="qs-step">Step 1 · Try without credentials</p>
							<h3 class="qs-title">Demo mode</h3>
							<p class="qs-desc">Bundled in-memory sample data; safe to run anywhere. <code>meta.demo: true</code> on every envelope.</p>
						</div>
						<div class="qs-code">
							<pre><code><span class="term-comment"># Install via Homebrew</span>
<span class="term-prompt">$</span> brew install thedavidweng/tap/<span class="term-cmd">money</span>

<span class="term-comment"># Or via Go</span>
<span class="term-prompt">$</span> go install github.com/thedavidweng/money/cmd/<span class="term-cmd">money</span>@latest

<span class="term-comment"># Try with sample data</span>
<span class="term-prompt">$</span> <span class="term-cmd">money</span> demo accounts list <span class="term-flag">--json</span>
<span class="term-prompt">$</span> <span class="term-cmd">money</span> demo transactions search <span class="term-str">"coffee"</span></code></pre>
						</div>
					</article>
					<article class="qs-card">
						<div class="qs-card-head">
							<p class="qs-step">Step 2 · Connect a provider</p>
							<h3 class="qs-title">Real sync (BYOK)</h3>
							<p class="qs-desc">Bring your own Plaid / Bridge credentials. <code>money</code> stores them in your encrypted local DB.</p>
						</div>
						<div class="qs-code">
							<pre><code><span class="term-comment"># Interactive setup — config, key, database</span>
<span class="term-prompt">$</span> <span class="term-cmd">money</span> setup

<span class="term-comment"># Link an institution, then sync</span>
<span class="term-prompt">$</span> <span class="term-cmd">money</span> link
<span class="term-prompt">$</span> <span class="term-cmd">money</span> sync
<span class="term-prompt">$</span> <span class="term-cmd">money</span> accounts list <span class="term-flag">--json</span></code></pre>
						</div>
					</article>
				</div>
				<p class="qs-foot">All commands accept <code class="inline-code">--json</code>. Write operations require <code class="inline-code">--dry-run</code> or <code class="inline-code">--confirm</code>.</p>
			</section>

			<!-- ============================ Architecture ============================ -->
			<section id="architecture" aria-labelledby="arch-heading">
				<p class="section-eyebrow">Architecture</p>
				<h2 id="arch-heading">One direction. Local data. Explicit sync.</h2>
				<div class="arch">
					<div class="arch-text">
						<p>
							Read commands never call the network. Outbound provider traffic only happens when you explicitly <span class="inline-code">link</span> or <span class="inline-code">sync</span>.
						</p>
						<p>
							Providers map into canonical records — accounts, transactions, categories, tags, recurring items — and land in encrypted SQLite. Every command returns a versioned JSON envelope with deterministic sorting and pagination.
						</p>
						<p style="margin-top: 1.25rem">
							<a href={docs('docs/ARCHITECTURE.md')}>Read the full architecture document →</a>
						</p>
					</div>
					<div class="arch-pipeline" role="img" aria-label="Data flow from provider to your agent">
						<span class="flow-step is-emphasis">Provider</span>
						<span class="flow-join" aria-hidden="true"></span>
						<span class="flow-step">Adapter</span>
						<span class="flow-join" aria-hidden="true"></span>
						<span class="flow-step">Canonical records</span>
						<span class="flow-join" aria-hidden="true"></span>
						<span class="flow-step">Encrypted SQLite</span>
						<span class="flow-join" aria-hidden="true"></span>
						<span class="flow-step">Core query</span>
						<span class="flow-join" aria-hidden="true"></span>
						<span class="flow-step">JSON contract</span>
						<span class="flow-join" aria-hidden="true"></span>
						<span class="flow-step is-endpoint">Your agent</span>
					</div>
				</div>
			</section>

			<!-- ============================ Docs ============================ -->
			<section id="docs" aria-labelledby="docs-heading">
				<p class="section-eyebrow">Documentation</p>
				<h2 id="docs-heading">Contracts and design docs</h2>
				<p class="section-lede">Everything <span class="inline-code">money</span> commits to lives in the repository. Stable contracts are reviewed before they're called stable.</p>
				<div class="docs-grid">
					{docsList.map((d) => (
						<a class="doc-card" href={docs(d.path)}>
							<span class="doc-card-name">{d.name}</span>
							<span class="doc-card-title">{d.title}</span>
							<span class="doc-card-desc">{d.desc}</span>
							<span class="doc-card-arrow">Open →</span>
						</a>
					))}
				</div>
				<div class="section-aside">
					<a href={repo}>Repository</a>
					<a href={docs('LICENSE')}>License (MIT)</a>
					<a href={`${repo}/issues`}>Issues</a>
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="layout-shell footer-grid">
				<div>
					<div class="footer-brand">
						<img src={`${base}Golden-Toad-logo.webp`} alt="" width="26" height="26" />
						<span>money</span>
					</div>
					<p class="footer-meta">
						A local-first personal finance backend for external AI agents.
						<br />
						MIT licensed · <a href={repo}>github.com/thedavidweng/money</a>
					</p>
				</div>
				<div class="footer-col">
					<h4>Acknowledgements</h4>
					<ul class="ack-list">
						<li><a href="https://github.com/thedavidweng/monarchmoney-cli">monarchmoney-cli</a> <span class="note">— CLI contracts, envelopes, safety</span></li>
						<li><a href="https://github.com/cdinnison/ray-finance">Ray Finance</a> <span class="note">— sync and local store patterns</span></li>
						<li><a href="https://github.com/actualbudget/actual">Actual Budget</a> <span class="note">— local-first budgeting</span></li>
						<li><a href="https://github.com/maybe-finance/maybe">Maybe Finance</a> <span class="note">— domain vocabulary (reference)</span></li>
					</ul>
				</div>
			</div>
		</footer>
	</body>
</html>
