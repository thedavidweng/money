---
import '../styles/global.css';

const base = import.meta.env.BASE_URL;
const repo = 'https://github.com/thedavidweng/money';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" href={`${base}favicon.png`} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;600&family=JetBrains+Mono:wght@400&display=swap"
			rel="stylesheet"
		/>
		<title>Page not found — money</title>
	</head>
	<body>
		<main style="max-width: 36rem; margin: 4rem auto; padding: 1rem; font-family: var(--font-sans, system-ui); color: var(--text, #e8ebe8)">
			<h1 style="font-size: 1.5rem">404</h1>
			<p style="color: var(--text-muted, #9aa89a)">This page does not exist.</p>
			<p>
				<a href={base}>Back to home</a>
				·
				<a href={repo}>GitHub</a>
			</p>
		</main>
	</body>
</html>
